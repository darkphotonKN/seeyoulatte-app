# Database Configuration (matches docker-compose.yml)
DB_HOST=localhost
DB_PORT=5466
DB_USER=user
DB_PASSWORD=password
DB_NAME=seeyoulatte_db

# Server Configuration
PORT=8080
LOG_LEVEL=debug

# Redis Configuration (from docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6387
REDIS_PASSWORD=password

# JWT Configuration - IMPORTANT: Change this in production!
JWT_SECRET=your-jwt-secret-key-change-in-production

# Google OAuth Configuration
# You'll need to set these up at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URL=http://localhost:3050/auth/google/callback

# Environment
ENVIRONMENT=development

# Stripe Configuration
# Get your test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Webhook secret from Stripe CLI or Dashboard
# For local testing: stripe listen --forward-to localhost:8080/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here