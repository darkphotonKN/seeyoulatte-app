# Compiled binaries — patterns are UN-anchored so they match in every
# services/* subdir, not just the workspace root.
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Go build outputs (Makefile writes to ./bin/, Air writes to ./tmp/)
bin/
tmp/

# Test coverage
*.out
coverage.out
coverage.html

# Dependency directories
vendor/

# Go workspace local state — keep go.work, ignore the sum so it's regenerated
go.work.sum

# Environment files (each service has its own .env; commit .env.example only)
.env
.env.local
.env.*.local

# Air build error log (kept in the watched dir)
build-errors.log

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
